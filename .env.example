# Copy to .env.local and fill in. .env.local is gitignored and must never be committed —
# this repository is public. See SETUP.md §3 for the full walkthrough.
#
# Fastest route on a machine with Vercel access:  npx vercel env pull .env.local

# Supabase → Project Settings → API. Both of these ship to the browser by design;
# the anon key is safe to expose because every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Same page, "service_role". Full database access and it bypasses RLS entirely.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET. Resend dashboard → API Keys. Production email is live: a notifications INSERT
# sends a real message to a real person.
RESEND_API_KEY=
# The verified sender on the Resend domain. Not a secret.
RESEND_FROM_EMAIL=

# The local origin during development. This stays localhost even on a working machine —
# it is not where the production domain is configured.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Written automatically by the Vercel CLI when you run `vercel env pull` or `vercel dev`.
# Do not fill it in by hand; it is short-lived.
# VERCEL_OIDC_TOKEN=
