# Identity of this collar, provisioned once via the collar_devices table.
DEVICE_ID=00000000-0000-0000-0000-000000000000
DEVICE_SECRET=change-me

# Where GPS uplinks are POSTed (the collar-ingest Supabase Edge Function).
INGEST_URL=https://jktykrbvwgagcjyuxypo.supabase.co/functions/v1/collar-ingest
# Anon key is fine here — the function itself checks DEVICE_ID/DEVICE_SECRET,
# this header is only required by Supabase's gateway to accept the request.
SUPABASE_ANON_KEY=

# Serial port the GPS module is wired to (NEO-6M over UART on a Pi 3/4/Zero: /dev/serial0).
GPS_SERIAL_PORT=/dev/serial0
GPS_BAUD_RATE=9600

# How often to read GPS + attempt an uplink, in seconds. Larger = better battery life.
FIX_INTERVAL_SECONDS=15

# Local queue file used when WiFi is unreachable; flushed once back online.
# Relative to wherever you run `python -m collar.main` from (or the systemd
# unit's WorkingDirectory) -- avoids hardcoding a username that may not be "pi".
OFFLINE_QUEUE_PATH=./queue.jsonl
